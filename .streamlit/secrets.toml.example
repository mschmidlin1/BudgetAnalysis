# Copy this file to `.streamlit/secrets.toml` and fill in values.
# Never commit `secrets.toml` (it is gitignored).
#
# The service account fields appear in TWO sections — use the same values
# from your GCP JSON key in both [connections.gsheets] and [gcp_service_account].

[connections.gsheets]
spreadsheet = "https://docs.google.com/spreadsheets/d/<SHEET_ID>/edit"
type = "service_account"
project_id = "<from-json>"
private_key_id = "<from-json>"
private_key = "<from-json>"
client_email = "<from-json>"
client_id = "<from-json>"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "<from-json>"

[gcp_service_account]
type = "service_account"
project_id = "<from-json>"
private_key_id = "<from-json>"
private_key = "<from-json>"
client_email = "<from-json>"
client_id = "<from-json>"
auth_uri = "https://accounts.google.com/o/oauth2/auth"
token_uri = "https://oauth2.googleapis.com/token"
auth_provider_x509_cert_url = "https://www.googleapis.com/oauth2/v1/certs"
client_x509_cert_url = "<from-json>"
universe_domain = "googleapis.com"

[gcs]
bucket_name = "<your-gcs-bucket-name>"

[cookie]
name = "budget_analysis_cookie"
key = "change-this-to-a-random-secret-in-production"
expiry_days = 30
